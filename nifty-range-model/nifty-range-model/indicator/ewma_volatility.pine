//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// EWMA Volatility (RiskMetrics) + Implied Vol comparison + Expected-move table
//
// Pane  : chart-timeframe EWMA vol, realized vol, implied vol (India VIX / manual)
// Chart : EWMA of price, ±k·σ next-bar bands, band-breach marks
// Table : EWMA (realized) vs IV (implied) expected ±1σ move in % and points
//
// Core recursion:  σ²_t = λ · σ²_{t-1} + (1 − λ) · r_t²
// Scaling rule:    move over N bars = per-bar σ × √N   (≈ 68% of the time price stays inside)
// Short horizons (next bar, 1 hour) use chart-timeframe EWMA.
// Long horizons (1 day, expiry) use DAILY EWMA (from yesterday's close) — steadier.
// ─────────────────────────────────────────────────────────────────────────────
indicator("EWMA Volatility (RiskMetrics)", shorttitle = "EWMA Vol", overlay = false, precision = 2)

// ── Inputs ───────────────────────────────────────────────────────────────────
grpV = "Volatility"
src      = input.source(close, "Source", group = grpV)
lambda   = input.float(0.94, "Decay λ", minval = 0.50, maxval = 0.999, step = 0.01, group = grpV,
     tooltip = "RiskMetrics: 0.94 daily. Higher λ = smoother, slower.")
seedLen  = input.int(20, "Seed length (bars)", minval = 2, group = grpV)
skipGaps = input.bool(true, "Intraday: ignore overnight-gap return", group = grpV)
showRV   = input.bool(true, "Show rolling realized vol", group = grpV)
rvLen    = input.int(20, "Realized vol length", minval = 2, group = grpV)

grpA = "Annualization"
tdays    = input.int(252, "Trading days / year", minval = 1, group = grpA)
sessMin  = input.int(375, "Session minutes / day", minval = 1, group = grpA, tooltip = "NSE = 375. Crypto = 1440.")

grpI = "Implied vol & ranges"
ivSym    = input.string("NSE:INDIAVIX", "IV symbol", group = grpI, tooltip = "India VIX for NIFTY.")
manualIV = input.float(0.0, "Manual IV % (0 = use symbol)", minval = 0, step = 0.1, group = grpI,
     tooltip = "Type the ATM IV of the expiry you trade (from the option chain). Most accurate for that expiry.")
showIV   = input.bool(true, "Plot IV in pane", group = grpI)
dailySym = input.string("", "Daily vol symbol (blank = chart)", group = grpI,
     tooltip = "On NIFTY futures, NSE:NIFTY (spot) avoids rollover jumps in daily vol.")
dte      = input.float(5, "Days to expiry (trading days)", minval = 0.1, step = 0.5, group = grpI)
expR     = input.float(1.3, "IV ÷ EWMA above this = expensive", minval = 1.0, step = 0.05, group = grpI)
cheapR   = input.float(1.0, "IV ÷ EWMA below this = cheap", minval = 0.5, step = 0.05, group = grpI)

grpR = "Regime"
pctLen   = input.int(750, "Percentile lookback", minval = 20, group = grpR, tooltip = "750 ≈ 10 days on 5-min NSE")
hiPct    = input.float(80, "High-vol percentile", minval = 50, maxval = 100, group = grpR)
loPct    = input.float(20, "Low-vol percentile", minval = 0, maxval = 50, group = grpR)
shadeBg  = input.bool(true, "Shade regimes", group = grpR)

grpO = "Chart overlay"
showPE   = input.bool(true, "Show EWMA of price", group = grpO)
peLen    = input.int(20, "Price EWMA span N  (α = 2/(N+1))", minval = 1, group = grpO)
showBand = input.bool(true, "Show expected-move bands", group = grpO)
k        = input.float(2.0, "Band width (σ multiples)", minval = 0.1, step = 0.1, group = grpO)
showHits = input.bool(true, "Mark band breaches", group = grpO)

// ── Chart-timeframe EWMA variance ───────────────────────────────────────────
rRaw = math.log(src / src[1])
r    = skipGaps and timeframe.isintraday and session.isfirstbar ? na : rRaw

var int   n     = 0
var float sumSq = 0.0
var float ewVar = na
if not na(r)
    n += 1
    if n <= seedLen
        sumSq += r * r
        if n == seedLen
            ewVar := sumSq / seedLen
    else
        ewVar := lambda * ewVar + (1 - lambda) * r * r

sigmaBar = math.sqrt(ewVar)

// ── Annualization ────────────────────────────────────────────────────────────
tfSec = timeframe.in_seconds()
float barsPerYear = timeframe.isintraday ? tdays * sessMin * 60.0 / tfSec :
     timeframe.isdaily  ? tdays * 1.0 / timeframe.multiplier :
     timeframe.isweekly ? 52.0 / timeframe.multiplier :
     12.0 / timeframe.multiplier
annF        = math.sqrt(barsPerYear)
barsPerHour = timeframe.isintraday and tfSec <= 3600 ? 3600.0 / tfSec : na

ewVolAnn = sigmaBar * annF * 100
rvAnn    = ta.stdev(nz(r), rvLen) * annF * 100

// ── Daily EWMA vol (as of yesterday's close — does not repaint) ─────────────
dailyEwmaVol(lam, seedN, td) =>
    rr = math.log(close / close[1])
    var int   cnt = 0
    var float s   = 0.0
    var float v   = na
    if not na(rr)
        cnt += 1
        if cnt <= seedN
            s += rr * rr
            if cnt == seedN
                v := s / seedN
        else
            v := lam * v + (1 - lam) * rr * rr
    math.sqrt(v) * math.sqrt(td) * 100

dailyVolPrev(lam, seedN, td) =>
    dv = dailyEwmaVol(lam, seedN, td)
    dv[1]

dSym     = dailySym == "" ? syminfo.tickerid : dailySym
dailyVol = request.security(dSym, "D", dailyVolPrev(lambda, seedLen, tdays), lookahead = barmerge.lookahead_on)

// ── Implied vol ──────────────────────────────────────────────────────────────
ivAuto = request.security(ivSym, timeframe.period, close, ignore_invalid_symbol = true)
iv     = manualIV > 0 ? manualIV : ivAuto

// ── Regime ───────────────────────────────────────────────────────────────────
pct    = ta.percentrank(ewVolAnn, pctLen)
isHigh = pct >= hiPct
isLow  = pct <= loPct
volCol = isHigh ? color.red : isLow ? color.teal : color.orange
regimeTxt = isHigh ? "High" : isLow ? "Low" : "Normal"
halfLife  = math.log(0.5) / math.log(lambda)

// ── Pane plots ───────────────────────────────────────────────────────────────
ivCol = color.rgb(186, 140, 255)
plot(ewVolAnn, "EWMA Vol (ann. %)", color = volCol, linewidth = 2)
plot(showRV ? rvAnn : na, "Realized Vol (ann. %)", color = color.new(color.gray, 20), linewidth = 1)
plot(showIV ? iv : na, "Implied Vol (ann. %)", color = ivCol, linewidth = 1, style = plot.style_linebr)
bgcolor(shadeBg and isHigh ? color.new(color.red, 88) : shadeBg and isLow ? color.new(color.teal, 88) : na,
     title = "Regime shading")

// ── Chart overlay: EWMA of price + bands ─────────────────────────────────────
alphaP = 2.0 / (peLen + 1)
var float ewPrice = na
ewPrice := na(ewPrice) ? src : ewPrice + alphaP * (src - ewPrice)
plot(showPE ? ewPrice : na, "EWMA Price", color = color.blue, linewidth = 2, force_overlay = true)

sigPrev = math.sqrt(ewVar[1])
upper   = src[1] * math.exp( k * sigPrev)
lower   = src[1] * math.exp(-k * sigPrev)
plot(showBand ? upper : na, "Upper band", color = color.new(color.purple, 30), style = plot.style_linebr, force_overlay = true)
plot(showBand ? lower : na, "Lower band", color = color.new(color.purple, 30), style = plot.style_linebr, force_overlay = true)

breachUp = not na(upper) and src > upper
breachDn = not na(lower) and src < lower
plotshape(showHits and breachUp, "Breach up",   shape.triangleup,   location.abovebar, color.green, size = size.tiny, force_overlay = true)
plotshape(showHits and breachDn, "Breach down", shape.triangledown, location.belowbar, color.red,   size = size.tiny, force_overlay = true)

// ── Expected ±1σ moves: EWMA (realized) vs IV (implied) ─────────────────────
rvDay = dailyVol / 100 / math.sqrt(tdays)       // daily σ from daily EWMA
ivBar = iv / 100 / annF                          // per-bar σ implied
ivDay = iv / 100 / math.sqrt(tdays)              // daily σ implied
sqH   = math.sqrt(barsPerHour)
sqE   = math.sqrt(dte)

ratio      = iv / dailyVol
verdict    = na(ratio) ? "–" : ratio >= expR ? "EXPENSIVE" : ratio <= cheapR ? "CHEAP" : "FAIR"
verdictCol = na(ratio) ? color.gray : ratio >= expR ? color.red : ratio <= cheapR ? color.lime : color.orange
buyerNote  = na(ratio) ? "" : ratio >= expR ? "be selective" : ratio <= cheapR ? "good for buyers" : "normal"

kv(tbl, row, label, val, valCol, note, noteCol) =>
    table.cell(tbl, 0, row, label, text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, row, val, text_color = valCol, text_size = size.small)
    table.cell(tbl, 2, row, note, text_color = noteCol, text_size = size.small)

rangeRow(tbl, row, label, sR, sI, px, cR, cI) =>
    table.cell(tbl, 0, row, label, text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, row, na(sR) ? "–" : str.tostring(sR * 100, "#.###") + "%", text_color = cR, text_size = size.small)
    table.cell(tbl, 2, row, na(sR) ? "–" : "±" + str.tostring(px * sR, "#.#"), text_color = cR, text_size = size.small)
    table.cell(tbl, 3, row, na(sI) ? "–" : str.tostring(sI * 100, "#.###") + "%", text_color = cI, text_size = size.small)
    table.cell(tbl, 4, row, na(sI) ? "–" : "±" + str.tostring(px * sI, "#.#"), text_color = cI, text_size = size.small)

var table tbl = table.new(position.top_right, 5, 12, bgcolor = color.new(color.black, 80), border_width = 1)
if barstate.islast
    kv(tbl, 0, "EWMA vol (chart)", str.tostring(ewVolAnn, "#.##") + "%", volCol, regimeTxt, volCol)
    kv(tbl, 1, "EWMA vol (daily)", str.tostring(dailyVol, "#.##") + "%", color.orange, "annual", color.gray)
    kv(tbl, 2, "Implied vol",      str.tostring(iv, "#.##") + "%", ivCol, manualIV > 0 ? "manual" : "VIX", color.gray)
    kv(tbl, 3, "IV ÷ daily EWMA",  str.tostring(ratio, "#.##"), verdictCol, verdict, verdictCol)
    table.cell(tbl, 3, 3, buyerNote, text_color = verdictCol, text_size = size.small)
    kv(tbl, 4, "Realized vol",     str.tostring(rvAnn, "#.##") + "%", color.white, "annual", color.gray)
    kv(tbl, 5, "Percentile",       str.tostring(pct, "#"), volCol, regimeTxt, volCol)
    table.cell(tbl, 0, 6, "±1σ move", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, 6, "EWMA %",   text_color = color.gray, text_size = size.small)
    table.cell(tbl, 2, 6, "EWMA pts", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 3, 6, "IV %",     text_color = color.gray, text_size = size.small)
    table.cell(tbl, 4, 6, "IV pts",   text_color = color.gray, text_size = size.small)
    rangeRow(tbl, 7,  "Next bar", sigmaBar,       ivBar,       src, color.orange, ivCol)
    rangeRow(tbl, 8,  "1 hour",   sigmaBar * sqH, ivBar * sqH, src, color.orange, ivCol)
    rangeRow(tbl, 9,  "1 day",    rvDay,          ivDay,       src, color.orange, ivCol)
    rangeRow(tbl, 10, "Expiry (" + str.tostring(dte) + "d)", rvDay * sqE, ivDay * sqE, src, color.orange, ivCol)
    kv(tbl, 11, "Half-life / λ", str.tostring(halfLife, "#.#") + " bars", color.white, str.tostring(lambda, "#.###"), color.white)

// ── Alerts ──────────────────────────────────────────────────────────────────
alertcondition(ta.crossover(pct, hiPct),     "Vol entering high regime", "EWMA vol crossed into high-percentile regime")
alertcondition(ta.crossunder(pct, loPct),    "Vol entering low regime",  "EWMA vol dropped into low-percentile regime")
alertcondition(breachUp or breachDn,         "Expected-move breach",     "Price closed outside the EWMA ±kσ band")
alertcondition(ta.crossunder(ratio, cheapR), "Options turned cheap",     "IV fell below daily EWMA vol — options cheap vs realized movement")
